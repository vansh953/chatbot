# Copy this file to .env and fill in real values. Never commit .env.

APP_NAME=MediMate API
ENV=development

# Generate a strong random value, e.g.: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/medimate

# Get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of allowed React frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
